from mido import Message, MidiFile, MidiTrack, MetaMessage

# --- Tạo file MIDI ---
mid = MidiFile()
track = MidiTrack()
mid.tracks.append(track)

# Tempo 75 BPM
track.append(MetaMessage('set_tempo', tempo=500000))

# --- Hợp âm cơ bản ---
# C3=48, G3=55, A3=57, F3=53
chord_progression = [
    [48, 55, 57],  # C
    [55, 59, 62],  # G
    [57, 60, 64],  # Am
    [53, 57, 60]   # F
]

# Mỗi hợp âm kéo dài 480 ticks (1 nhịp)
for _ in range(2):  # lặp 2 lần cho demo
    for chord in chord_progression:
        for note in chord:
            track.append(Message('note_on', note=note, velocity=60, time=0))
        # Giữ hợp âm 480 ticks
        for note in chord:
            track.append(Message('note_off', note=note, velocity=60, time=480))

# --- Melody giọng nam trầm (C3-G3-A3-F3 pattern) ---
melody_notes = [48, 50, 52, 55, 57, 55, 52, 50]  # nốt demo cho 8 nhịp
for note in melody_notes:
    track.append(Message('note_on', note=note, velocity=70, time=0))
    track.append(Message('note_off', note=note, velocity=70, time=240))  # mỗi nốt nửa nhịp

# --- Lưu file ---
mid.save('trai_tim_cach_dai_duong_demo.mid')
print("File MIDI đã được tạo: trai_tim_cach_dai_duong_demo.mid")
